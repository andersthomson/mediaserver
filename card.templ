//go:generate go tool templ generate -lazy -include-timestamp=false
package main

import (
	"strings"
	"slices"
	"maps"
//	"fmt"
//	"github.com/andersthomson/mediaserver/datasource"
//	"github.com/andersthomson/mediaserver/scrape"
//	"github.com/davecgh/go-spew/spew"
	)

templ CardPoster4ID(u string) {
	if u != "" {
		<img src={ templ.SafeURL(u) } />
	}
}
templ CardTitle4ID(title string) {
	if title != "" {
		   { title } <br>
        }
}

templ CardGenres4ID(genres []string) {
	if len(genres) != 0 {
		Genres: { strings.Join(genres,", ") } <br>
	}
}

templ CardTagline4ID(tagline string) {
	if tagline != "" {
		Tagline: { tagline } <br>
	}
}

templ CardOverview4ID(overview string) {
	if overview != "" {
		Overview: { overview } <br>
	}
}

templ CardLinks4ID(download, html5, cast, shaka string) {
	<div id="navigation">
	if download != "" {
		<a href={ templ.SafeURL(download) }>&lt;Download&gt;</a>
	}
	if html5 != "" {
		<a href={ templ.SafeURL(html5) }>&lt;Play in browser&gt;</a>
	}
	if cast != "" {
		<a href={ templ.SafeURL(cast) }>&lt;Play on ChromeCast&gt;</a><br> 
	}
	if shaka != "" {
		<a href={ templ.SafeURL(shaka) }>&lt;Play on Shaka&gt;</a><br>
	}
	</div>
}


templ Card4ID(cvm SearchCardViewModel) {
        <div class="card">
        @CardPoster4ID(cvm.PosterURL)
        @CardTitle4ID(cvm.Title)
	@CardGenres4ID(cvm.Genres)
	@CardTagline4ID(cvm.Tagline)
	@CardOverview4ID(cvm.Overview)
	@CardLinks4ID(cvm.DownloadURL,cvm.Html5URL,cvm.CastURL,cvm.ShakaURL)
        </div>
}

templ Cards4IDs(splits SearchViewModel) {
        for _, key := range slices.Sorted(maps.Keys(splits)) {
                <b>{key}</b><br>
                <div class="row-content">
                for _,cvm := range splits[key] {
                        @Card4ID(cvm)
                }
                </div>
                <br>
        }
}
