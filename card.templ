//go:generate go tool templ generate -lazy -include-timestamp=false
package main

import (
	"strings"
	"slices"
	"maps"
	"fmt"
	"github.com/andersthomson/mediaserver/datasource"
	"github.com/andersthomson/mediaserver/scrape"
//	"github.com/davecgh/go-spew/spew"
	)

templ Card(content templ.Component) {
     <div class="card-body">
     @content
   </div>
}

templ links(ds datasource.DataSource) {
	<div id="navigation">
	<a href={mediaURL(ds)}>&lt;Download&gt;</a>
	<a href={html5URL(ds)}>&lt;Play in browser&gt;</a>
	<a href={ castURL(ds)}>&lt;Play on ChromeCast&gt;</a><br> 
	if u,ok := shakaURL2(ds) ; ok {
		<a href={ templ.SafeURL(u) }>&lt;Play on Shaka&gt;</a><br>
	}
	</div>
}
templ ItemCard(ds *scrape.ItemData) {
	<div class="card">
	<img src={posterURLGen(ds)} /><br>
	{ds.Title()}<br>
	<b>QA Notice: Uses Item scaper</b><br>
	@links(ds)
	//<i>{ds.Tagline()}</i><br>
	//{ds.Overview()}<br>
	</div>
}

templ TMDBMovieCard(ds *scrape.TMDBMovie) {
	<div class="card">
	@CardPoster(ds)
	{ds.Title()}<br>
	@links(ds)
	<i>{ds.Tagline()}</i><br>
	{ds.Overview()}<br>
	</div>
}

templ svtplayCard(ds *scrape.SvtplayItem) {
	<div class="card">
	<img src={posterURLGen(ds)} /><br>
	{ds.Title()}<br>
	@links(ds)
	//<i>{ds.Tagline()}</i><br>
	//{ds.Overview()}<br>
	</div>
}

templ TMDBEpisodeCard(ds *scrape.TMDBTVEpisode) {
	<div class="card">
	<img src={posterURLGen(ds)} /><br>
	{ds.Title()}<br>
	@links(ds)
	<i>{ds.Tagline()}</i><br>
	{ds.Overview()}<br>
	</div>
}

templ Card4Episode(ds *scrape.TMDBTVEpisode) {
	@Card(TMDBEpisodeCard(ds))
}

templ Card4Movie(ds *scrape.TMDBMovie) {
	@Card(TMDBMovieCard(ds))
}

templ Card4Item(ds *scrape.ItemData) {
        @Card(ItemCard(ds))
}

templ Card4svtplay(ds *scrape.SvtplayItem) {
        @Card(svtplayCard(ds))
}

templ CardTitle(ds datasource.DataSource) {
	if t := datasource.TitleOrZero(ds); t != "" {
		   { t } <br>
        } else if t := datasource.ShortNameOrZero(ds); t != "" {
                   { t } <br>
        }
}

templ CardPoster(ds datasource.DataSource) {
	if u,ok := posterURL2(ds) ; ok {
		<img src={ templ.SafeURL(u) } />
	}
}

type tagliner interface {
	Tagline() (string,bool)
}
templ CardTagline(ds datasource.DataSource) {
	if t,ok := ds.(tagliner) ; ok {
		if txt,ok := t.Tagline() ; ok && txt != "" {
			Tagline: { txt } <br>
		}
	}
}

type overviewer interface {
	Overview() (string,bool)
}
templ CardOverview(ds datasource.DataSource) {
	if o,ok := ds.(overviewer) ; ok {
		if txt,ok := o.Overview()  ; ok && txt != "" {
			Overview: { txt } <br>
		}
	}
}

type genreser interface {
	Genres() ([]string,bool)
}
templ CardGenres(ds datasource.DataSource) {
	if g,ok := ds.(genreser) ; ok {
		if txt,ok := g.Genres()  ; ok && len(txt) != 0 {
			Genres: { strings.Join(txt,", ") } <br>
		}
	}
}

templ Card4StreamAsset(ds *scrape.StreamAsset) {
	<div class="card">
	@CardPoster(ds)
	@CardTitle(ds)
	@CardGenres(ds)
	@CardOverview(ds)
	@links(ds)
	</div>
}

templ Cards4Datasources(splits map[string][]datasource.DataSource) {
	for _, key := range slices.Sorted(maps.Keys(splits)) {
		<b>{key}</b><br>
		<div class="row-content">
		for _,ds := range splits[key] {
			switch dsT := ds.(type) {
			case *scrape.TMDBMovie:
				@Card4Movie(dsT)
			case *scrape.TMDBTVEpisode:
				@Card4Episode(dsT)
			case *scrape.SvtplayItem:
				@Card4svtplay(dsT)
			case *scrape.ItemData:
				@Card4Item(dsT)
			case *scrape.StreamAsset:
				@Card4StreamAsset(dsT)
			default:
				{fmt.Sprintf("Unsupported datasource %T\n",dsT)}
			}
		}
		</div>
		<br>
	}
}
	
